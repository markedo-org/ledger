# Local / hosted environment (do not commit a filled copy)

LEDGER_BOOT_TOKEN=lgr_dev

# Process defaults for DONE retention. 0 means never. A ledger can override
# with `ledger ledger set`. purge must be 0, or >= archive, and archive
# cannot be 0 if purge is set.
LEDGER_ARCHIVE_DONE_AFTER_DAYS=7
LEDGER_PURGE_DONE_AFTER_DAYS=0

# Host-level operator token. Creates owners and sets max_ledgers. Distinct
# from the boot token (which is owner admin). Empty = operator API off.
LEDGER_OPERATOR_TOKEN=

# Require a session for HTML (token login and/or GitHub). 0 = live view open.
LEDGER_HTML_AUTH=0

# GitHub OAuth for HTML (optional extra). Empty = GitHub sign-in off.
LEDGER_GITHUB_CLIENT_ID=
LEDGER_GITHUB_CLIENT_SECRET=
LEDGER_GITHUB_CALLBACK_URL=https://<domain>/auth/github/callback
LEDGER_GITHUB_ALLOWLIST=octocat
LEDGER_SECURE_COOKIES=0

# Which peers may set X-Forwarded-For on your behalf, comma-separated CIDRs.
# Loopback is always trusted, which covers nginx and the binary on one host.
# Add your proxy here if it runs elsewhere, or your CDN's ranges if one sits in
# front. Leave empty when the binary is exposed directly: an untrusted caller's
# forwarded header is ignored, so it cannot dodge the sign-in rate limit or
# spend someone else's allowance.
LEDGER_TRUSTED_PROXIES=

# GET / with no extra path: login (default), url, or file.
# Brochure in front of the apex: LEDGER_ROOT=url and LEDGER_ROOT_URL=https://www.example.com
LEDGER_ROOT=login
LEDGER_ROOT_URL=
LEDGER_ROOT_FILE=

# Public base URL for magic-link emails. Default http://127.0.0.1:8080
LEDGER_PUBLIC_URL=http://127.0.0.1:8080

# Brochure / billing site. When set, the owner page links there to add
# ledgers. Leave empty on a self-host so no billing copy appears.
# LEDGER_SITE_URL=https://www.task-ledger.com

# Magic-link email. Off until LEDGER_SMTP_HOST, LEDGER_SMTP_USER,
# LEDGER_SMTP_PASS, and LEDGER_SMTP_FROM are all set.
# FROM defaults to USER. Port 465 = implicit TLS. Do not put a personal
# mailbox on the hosted service.
LEDGER_SMTP_HOST=
LEDGER_SMTP_PORT=465
LEDGER_SMTP_USER=
LEDGER_SMTP_PASS=
LEDGER_SMTP_FROM=
